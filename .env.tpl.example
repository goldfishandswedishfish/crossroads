# 1Password secret references for `op run`.
# Copy this file to .env.tpl, then replace the op:// paths with your own.
# Find your secret references in 1Password: right-click a field → Copy Secret Reference.
#
# Usage:  op run --env-file=.env.tpl -- python3 server.py
#    or:  ./start.sh

SPOTIFY_CLIENT_ID=op://YourVault/YourItem/spotify_client_id
YOUTUBE_API_KEY=op://YourVault/YourItem/youtube_api_key

# Optional — only needed if you change Ollama defaults
# OLLAMA_URL=op://YourVault/YourItem/ollama_url
# OLLAMA_MODEL=op://YourVault/YourItem/ollama_model
